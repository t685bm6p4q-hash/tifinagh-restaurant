{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-pdf-worker.mjs && next dev",
    "build": "node scripts/copy-pdf-worker.mjs && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "check:any": "node -e \"const {execSync}=require('child_process'); try { const o=execSync(\\\"grep -RInE '\\\\bas any\\\\b|: any\\\\b|<any>|Array<any>|Promise<any>|Record<string,\\\\s*any>' --include='*.ts' --include='*.tsx' --exclude-dir=node_modules --exclude-dir=.next .\\\",{encoding:'utf8'}); if(o.trim()){console.error(o); process.exit(1)} } catch(e){ if(e.status===1){console.log('OK: zero any'); process.exit(0)} throw e }\"",
    "check:menu-storage": "node scripts/check-menu-storage-invariants.mjs",
    "verify:menu-prod": "node scripts/verify-menu-production.mjs",
    "measure:html": "node scripts/measure-html-prod.mjs",
    "precommit": "npm run check:any && npm run check:menu-storage && npm run lint && npm run typecheck && npm test",
    "menu:generate": "node scripts/generate-menu-pdf.js",
    "images:optimize": "node scripts/optimize-images.mjs",
    "images:map-preview": "node scripts/generate-map-preview.mjs",
    "images:fix-logos": "node scripts/fix-logo-transparency.mjs",
    "icons:generate": "node scripts/generate-favicons.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "lucide-react": "^1.16.0",
    "next": "16.3.8",
    "pdfjs-dist": "^6.4.299",
    "react": "^19",
    "react-dom": "^19",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "husky": "^9.1.7",
    "pdfkit": "^0.20.1",
    "typescript": "5.7.3"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ]
}
