# URL publique unique (www). Ne pas mettre tifinagh.fr sans www ni *.vercel.app :
# Google refuse d'indexer une URL qui redirige vers une autre qui se déclare canonique inverse.
NEXT_PUBLIC_SITE_URL=https://www.tifinagh.fr

# Google Analytics 4 — laisser vide pour désactiver le tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Meta Pixel (Facebook / Instagram) — chiffres seuls, ex. 2023652001332480 (sans « ID » ni retour ligne)
NEXT_PUBLIC_META_PIXEL_ID=

# Admin menu du jour (obligatoire en prod pour /admin et l’upload PDF)
MENU_ADMIN_PASSWORD=

# Vercel Blob — token lecture/écriture pour stocker le PDF du menu du jour
BLOB_READ_WRITE_TOKEN=

# Production : mettre 0 uniquement après nettoyage Storage + re-upload admin (voir VERCEL_SETUP.md §8)
# MENU_BLOB_ALLOW_PUBLIC_FALLBACK=0
